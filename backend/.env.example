# Port serwera API
PORT=4000

# Baza danych. Lokalnie SQLite; na hostingu podaj ścieżkę do trwałego dysku.
DATABASE_URL="file:./dev.db"

# Adresy frontendu, którym wolno wywoływać API (oddzielone przecinkami).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Publiczny adres backendu używany do budowania URL-i plików.
# Na produkcji np. https://agat-hotel-api.onrender.com
PUBLIC_BASE_URL=

# Katalog na wgrane pliki (zdjęcia, modele 3D itp.).
UPLOAD_DIR=uploads

# Maksymalny rozmiar pliku w MB.
MAX_UPLOAD_MB=50

# Token wymagany do wgrywania i usuwania plików.
# Wygeneruj długi losowy ciąg, np. openssl rand -hex 32
ADMIN_TOKEN=zmien-mnie-na-dlugi-losowy-token
