# Port serwera API
PORT=4000

# Baza danych PostgreSQL.
# Lokalnie: uruchom `docker compose up -d db` w katalogu głównym repo.
# Na produkcji wklej connection string z Neon (bez poolera, z ?sslmode=require).
DATABASE_URL="postgresql://agat:agat@localhost:5432/agat?schema=public"

# Adresy frontendu, którym wolno wywoływać API (oddzielone przecinkami).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Publiczny adres backendu używany do budowania URL-i plików lokalnych.
# Na produkcji np. https://agat-hotel-api.onrender.com
PUBLIC_BASE_URL=

# Sposób przechowywania plików: "local" (dysk) albo "s3" (Neon Object Storage / R2).
STORAGE_DRIVER=local

# Katalog na pliki przy STORAGE_DRIVER=local.
UPLOAD_DIR=uploads

# Maksymalny rozmiar pliku w MB.
MAX_UPLOAD_MB=50

# Token wymagany do wgrywania i usuwania plików.
# Wygeneruj długi losowy ciąg, np. openssl rand -hex 32
ADMIN_TOKEN=zmien-mnie-na-dlugi-losowy-token

# --- Magazyn S3 (wymagane przy STORAGE_DRIVER=s3) ---
# Neon Object Storage: endpoint i region znajdziesz w konsoli Neon (Object storage).
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com, region "auto".
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Opcjonalny publiczny prefix URL plików (bez końcowego ukośnika).
# Dla Neon zwykle: https://<branch-id>.storage.c-<N>.<region>.aws.neon.tech/<bucket>
# Dla R2: publiczny adres r2.dev albo własna domena.
S3_PUBLIC_BASE_URL=
